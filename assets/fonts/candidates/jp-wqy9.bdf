SLANT "R"
ADD_STYLE_NAME ""
FONT_VERSION "000.998"
PIXEL_SIZE 12
POINT_SIZE 120
DEFAULT_CHAR 0
RESOLUTION_X 75
RESOLUTION_Y 75
RESOLUTION 75
